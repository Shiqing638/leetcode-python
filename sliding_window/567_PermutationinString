class Solution:
    def checkInclusion(self, s1: str, s2: str)-> bool:
        if len(s1) > len(s2):
            return False

        s1_freq = [0] * 26
        s2_freq = [0] * 26


        n = len(s1)
        for i in range(n):
            s1_freq[ord(s1[i]) - ord('a')] += 1
            s2_freq[ord(s2[i]) - ord('a')] += 1
        
        if s1_freq == s2_freq:
            return True

        m = len(s2)
        for j in range(n, m):
            s2_freq[ord(s2[j]) - ord('a')] += 1
            s2_freq[ord(s2[j-n]) - ord('a')] -= 1
            if s1_freq == s2_freq:
                return True
        return False
