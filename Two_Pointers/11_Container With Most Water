# Methode 1: brute force
# Methode 2: two pointer
class Solution:
    def maxArea(self, height: list[int]) -> int:
        res = 0
        left = 0
        right = len(height) - 1
        while left < right:
            vol = min(height[left], height[right]) * (right-left)
            if height[left] < height[right]:
                left += 1
            else:
                right -= 1

            res = max(res, vol)
        return res

height = [1,8,6,2,5,4,8,3,7]
sol = Solution()
print(sol.maxArea(height))